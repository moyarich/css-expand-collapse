{
  "name": "css-expand-collapse-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/css-expand-collapse-playground",
    "dev:playground": "npm run dev --workspace @moyarich/css-expand-collapse-playground",
    "generate:registry": "npm run generate:registry --workspace @moyarich/css-expand-collapse",
    "build": "npm run build:lib && npm run build:playground",
    "build:lib": "npm run build --workspace @moyarich/css-expand-collapse",
    "build:playground": "npm run build --workspace @moyarich/css-expand-collapse-playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run format && npm run lint && npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @moyarich/css-expand-collapse",
    "pack:lib": "npm pack --workspace @moyarich/css-expand-collapse --dry-run",
    "release:check": "node scripts/publish.mjs --dry-run",
    "publish:lib": "node scripts/publish.mjs --publish",
    "release": "node scripts/version.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/css-expand-collapse.git"
  },
  "devDependencies": {
    "commander": "^15.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.70.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "globals": "^17.12.0"
  },
  "bin": {
    "workspace-release": "./scripts/version.mjs",
    "workspace-publish": "./scripts/publish.mjs",
    "workspace-sync-readme": "./scripts/sync-package-readme.mjs"
  }
}
