{
  "name": "@moyarich/css-experimental-shorthands",
  "version": "0.1.0",
  "description": "Opt-in experimental CSS shorthand transformations",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && node -e \"require('node:fs').copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@moyarich/css-expand-collapse": "^0.1.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Moya Richards",
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/css-expand-collapse.git",
    "directory": "packages/css-experimental-shorthands"
  },
  "homepage": "https://github.com/moyarich/css-expand-collapse/tree/main/packages/css-experimental-shorthands",
  "bugs": {
    "url": "https://github.com/moyarich/css-expand-collapse/issues"
  },
  "keywords": [
    "css",
    "shorthand",
    "longhand",
    "experimental",
    "plugin"
  ]
}
