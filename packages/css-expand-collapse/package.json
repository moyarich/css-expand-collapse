{
  "name": "@moyarich/css-expand-collapse",
  "version": "0.1.1",
  "description": "Expand CSS shorthands into longhands and safely collapse compatible longhands back into shorthands.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:registry": "node scripts/generate-registry.mjs",
    "check:registry": "node scripts/generate-registry.mjs --check",
    "build": "npm run check:registry && tsup src/index.ts --format esm,cjs --dts --clean && node -e \"require('node:fs').copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "typecheck": "npm run check:registry && tsc --noEmit",
    "test": "npm run check:registry && vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/sync-package-readme.mjs --package-directory=packages/css-expand-collapse && npm run build",
    "postpack": "node ../../scripts/sync-package-readme.mjs --package-directory=packages/css-expand-collapse --clean",
    "preversion": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "css-tree": "^3.2.1"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/css-expand-collapse.git",
    "directory": "packages/css-expand-collapse"
  },
  "bugs": {
    "url": "https://github.com/moyarich/css-expand-collapse/issues"
  },
  "homepage": "https://moyarich.github.io/css-expand-collapse/",
  "keywords": [
    "css",
    "shorthand",
    "longhand",
    "css-parser",
    "css-transform",
    "css-tree",
    "computed-style",
    "chrome-extension",
    "browser-extension",
    "stylesheet"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Moya Richards"
}
